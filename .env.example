APP_NAME="Iran Build Expo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MariaDB (XAMPP): create the database first (utf8mb4_unicode_ci).
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iran_build_expo
DB_USERNAME=root
DB_PASSWORD=

# No database tables for these: shared hosting has no queue worker/cron.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# First admin (used once by `php artisan db:seed`; leave ADMIN_PASSWORD empty to get a random one printed).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# The single external origin allowed in an <iframe> (virtual tour page). Placeholder until the real URL is known.
TOUR3D_URL=https://DUMMY-3DTour.invalid
