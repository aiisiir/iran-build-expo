# Copy to app/.env on the server and fill in. NEVER commit the real file.
APP_NAME="Iran Build Expo"
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show   (run locally; new key for production)
APP_DEBUG=false
APP_URL=https://iranbuildexpo.mahdiarmansouri.ir
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Virtual tour iframe origin (CSP frame-src is opened for it on the tour page only). Replace the placeholder.
TOUR3D_URL=https://DUMMY-3DTour.invalid
